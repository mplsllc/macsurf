+++ b/browser/netsurf/content/handlers/html/html.c
@@
 #define RECONV_PH_H1        0
 #define RECONV_PH_H3        1	/* forms + imagemap + selection      */
 #define RECONV_PH_CSS       2	/* release pass-1 libcss node data   */
