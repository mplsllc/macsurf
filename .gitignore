# Private archive folder (intermediate ship zips, dev snapshots, etc.)
.private/

# Per-user assistant state directories (local conversation transcripts,
# session caches). The project-context files themselves (CLAUDE.md,
# GEMINI.md) are tracked in the repo for transparency.
.claude/
.gemini/
AGENTS.md
COPILOT.md

# Build archives & fix tars (these go to .private/archives/)
*.zip
*.tar
*.tar.gz
*.tgz
*.sit
*.hqx
# Exceptions: the public build pack + ready-to-run binary live in builds/
!builds/MacSurf-BuildPack.sit
!builds/MacSurf.sit
!builds/Complete-Project-060126.sit

# Build artifacts
MacSurf
MacSurf.xml
*.o
*.a
*.lib

# Runtime logs
*.log
MacSurf Debug.log
StdLog

# macOS resource-fork metadata
._*
.DS_Store

# Scratch error logs
errors*.txt
errrors*.txt
newerrors*.txt
newerrors*txt
build-error-*.txt

# Node / Gemini CLI dependencies (moved to .private)
node_modules/
package.json
package-lock.json

# Legacy / scratch build trees
clean_macsurf/
flat_macsurf_sources/
tree_macsurf/
build/
for-gemini/

# Misc scratch
text.txt
test_ending.txt
test_pragma.c
animation.as
forgem/

# macSSL is its own git repo at macSSL/ — manage separately (submodule or merge later)
macSSL/

# Scratch/reference dir for Claude sessions — never tracked (large HARs, logs, tars)
forclaude/

# Embedded reference repos — each has its own .git, never track here
NanoKernel/
browser/buildsystem/

# User-uploaded debug logs (may contain sensitive data) — organized by date, never commit
/builds/logs/

# Python bytecode cache
__pycache__/
*.pyc

# S0 harness (Linux-only ASan dev tool, never shipped) — keep the scripts,
# drop the build output. harness/build/ holds symlinks into the real shipped
# source (zero-drift compile inputs, not build output) -- unignore it despite
# the generic build/ rule above.
/harness/obj/
/harness/reconvert_harness
!/harness/build/
!/harness/build/*
harness/jquery-3.7.1.min.js
# Same reason as jquery above: a vendored third-party bundle the harness runs to
# test against REAL code rather than a synthetic mock. 87 KB of someone else's
# minified output does not belong in this repo's history; the tests SKIP cleanly
# when it is absent (fetch it from the site's HAR to run that leg).
harness/verbum-comments.js

# Profiler / stray patch / scratch data outputs (never track at repo root)
/gmon.out
/*.out
/*.diff
/*.patch
/*.orig
/*.csv
/MacSurf.sit

# Editor swap files
*.swp
*.swo
