animation.as
forgem/

# macSSL is its own git repo at macSSL/ — manage separately (submodule or merge later)
macSSL/

# Scratch/reference dir for Claude sessions — never tracked (large HARs, logs, tars)
forclaude/

# Embedded reference repos — each has its own .git, never track here
NanoKernel/
browser/buildsystem/

# User-uploaded debug logs (may contain sensitive data) — organized by date, never commit
/builds/logs/

# Python bytecode cache
__pycache__/
*.pyc

# S0 harness (Linux-only ASan dev tool, never shipped) — keep the scripts,
# drop the build output. harness/build/ holds symlinks into the real shipped
# source (zero-drift compile inputs, not build output) -- unignore it despite
# the generic build/ rule above.
/harness/obj/
/harness/reconvert_harness
!/harness/build/
!/harness/build/*
harness/jquery-3.7.1.min.js
# Same reason as jquery above: a vendored third-party bundle the harness runs to
# test against REAL code rather than a synthetic mock. 87 KB of someone else's
# minified output does not belong in this repo's history; the tests SKIP cleanly
# when it is absent (fetch it from the site's HAR to run that leg).
harness/verbum-comments.js

# Profiler / stray patch / scratch data outputs (never track at repo root)
/gmon.out
/*.out
/*.diff
/*.patch
/*.orig
/*.csv
/MacSurf.sit

# Editor swap files
*.swp
*.swo

# Compiled test/tool binaries (rebuildable from the sources beside them)
/quickjs-macos9/qjs_test
/macTLS/tests/host/test_tls13_handshake
/macTLS/tests/host/test_tls13_keysched
/macTLS/tests/host/test_tls13_record
/macTLS/tests/host/test_tls13_ticket
/macTLS/tests/host/test_tls13_ticket_cache

